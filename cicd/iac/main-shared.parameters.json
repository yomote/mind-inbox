{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "_comment": "持続層 (ADR 0046 D1 / #302)。適用先は rg-shared-mindbox。Cosmos / OpenAI / Speech / Log Analytics は移行が済むまで false のまま (理由は main-shared.bicep 冒頭)。",
  "parameters": {
    "appName": {
      "value": "mind-box"
    },
    "environmentName": {
      "value": "dev"
    },
    "enableKeyVault": {
      "value": true
    },
    "keyVaultLocation": {
      "value": "japaneast"
    },
    "enableE2eTraceKey": {
      "value": true
    },
    "enableBackupStorage": {
      "value": true
    },
    "backupStorageLocation": {
      "value": "japaneast"
    },
    "enableLogAnalytics": {
      "value": false
    },
    "enableCosmos": {
      "value": false
    },
    "enableOpenAi": {
      "value": false
    },
    "enableSpeech": {
      "value": false
    },
    "enableBudgetAlert": {
      "value": true
    },
    "budgetStartDate": {
      "value": "2026-09-01"
    }
  }
}
