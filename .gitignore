# Azure アイコンは commit する (icons/ は ignore しない)。
# 配布元 CDN (arch-center.azureedge.net) が廃止され per-machine ダウンロードが
# 成立しなくなったため、図の再現性を優先してリポジトリに置く。
cicd/scripts/viz-structure/icons/.cache/
cicd/scripts/viz-structure/icons/raw/
cicd/scripts/viz-structure/artifacts/

# Bicep compile outputs (generated ARM templates)
cicd/iac/*.json
!cicd/iac/*.parameters.json
cicd/modules/*.json

node_modules
dist

__pycache__

.local

# Azure Functions local config (may contain secrets)
**/local.settings.json

# MCP / E2E ツールのスクラッチ
.playwright-mcp/
.serena/

# viz-structure.sh が生成するルート artifacts (再生成可能)
artifacts/

# Playwright (L3) の生成物 — レポート / スクリーンショット / trace
apps/frontend/playwright-report/
apps/frontend/test-results/

# Playwright (L3-real / UC 受け入れ) の生成物 — ADR 0030
apps/frontend/test-results-uc/
apps/frontend/dist-e2e-uc/

# Playwright (L4 live) + UX プローブの生成物 — 記録は workflow artifact が真実 (#123 M0)
apps/frontend/test-results-live/
apps/frontend/probe-results/

# Claude Code personal settings
.claude/settings.local.json
.claude/worktrees/
