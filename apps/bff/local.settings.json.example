{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",

    "// AI_AGENT_BASE_URL": "未設定なら BFF が stub レスポンスで動作する",
    "AI_AGENT_BASE_URL": "",

    "// VOICEVOX_BASE_URL": "未設定なら /api/tts が 204 を返し、フロントは Web Speech にフォールバック",
    "VOICEVOX_BASE_URL": "",

    "// AI_AGENT_AUDIENCE / VOICEVOX_AUDIENCE": "Container Apps 組み込み認証 (#86 / ADR 0017) 向け。ローカルでは空のまま — 空なら Authorization を付けず、門の無いローカルサービスにそのまま繋がる (Azure 上でのみ bicep が値を配線する)",
    "AI_AGENT_AUDIENCE": "",
    "VOICEVOX_AUDIENCE": "",

    "// SPEECH_RESOURCE_ID / SPEECH_REGION": "Azure Speech (ADR 0023)。ローカルでは空のまま — 未設定なら speech.issueToken が available:false を返し、フロントは Web Speech にフォールバック (Azure 上でのみ bicep が値を配線する)",
    "SPEECH_RESOURCE_ID": "",
    "SPEECH_REGION": "",

    "// COSMOS_ENDPOINT": "Cosmos DB による永続化 (ADR 0030)。**ローカルでは空のまま** — 空なら in-memory リポジトリで動く (再起動で消えるが外部依存ゼロ / D7)。Azure 上でのみ bicep が値を配線する。キー・接続文字列は存在しない (disableLocalAuth: true) ので、値を入れても Managed Identity の無いローカルからは繋がらない",
    "COSMOS_ENDPOINT": "",

    "// COSMOS_DATABASE / COSMOS_*_CONTAINER": "器の名前。既定値がコード側にあるので通常は空でよい (mindinbox / problems)",
    "COSMOS_DATABASE": "",
    "COSMOS_PROBLEMS_CONTAINER": ""
  }
}
