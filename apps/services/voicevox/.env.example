# VOICEVOX wrapper (FastAPI) — environment template.
# Copy to `.env` for local dev. No secrets required (pure proxy to the engine).

# Base URL of the VOICEVOX engine (Docker-based; see
# cicd/scripts/local-voicevox/start-voicevox.sh).
VOICEVOX_ENGINE_BASE_URL=http://localhost:50021

# Port this wrapper listens on. The BFF's VOICEVOX_BASE_URL should point here
# (the docs/dev wiring uses http://localhost:8001).
PORT=8001
