# AI Agent (FastAPI + Semantic Kernel) — environment template.
# Copy to `.env` for local dev, or set these as secrets in the Claude Code
# web environment. Do NOT commit real keys.
#
# pydantic-settings reads OS environment variables directly, so values set as
# web-environment secrets are picked up automatically without a .env file.

# --- Option A: Azure OpenAI (preferred for Azure deployments) ---
# If AZURE_OPENAI_ENDPOINT is set, the Azure path is used.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01
# Use Azure Managed Identity instead of an API key (Container Apps deployments).
USE_MANAGED_IDENTITY=false

# --- Option B: OpenAI (fallback when AZURE_OPENAI_ENDPOINT is empty) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Misc ---
LOG_LEVEL=INFO
# VOICEVOX integration (currently a stub / feature-flagged off).
VOICEVOX_URL=http://localhost:50021
VOICEVOX_ENABLED=false
