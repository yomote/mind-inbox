{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__Claude_Code_Remote",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a",
      "mcp__github",
      "mcp__Claude_Code_Remote__create_session",
      "mcp__Claude_Code_Remote__archive_session",
      "mcp__Claude_Code_Remote__set_session_title",
      "mcp__Claude_Code_Remote__interrupt_session",
      "mcp__Claude_Code_Remote__delete_trigger",
      "mcp__Claude_Code_Remote__update_trigger",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__create_session",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__archive_session",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__set_session_title",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__interrupt_session",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__delete_trigger",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__update_trigger",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git stash)",
      "Bash(git stash:*)",
      "Bash(git grep:*)",
      "Bash(git merge-tree:*)",
      "Bash(npm run lint)",
      "Bash(npm run lint:md)",
      "Bash(npm run test:fast)",
      "Bash(npm run test:scripts)",
      "Bash(npm test)",
      "Bash(npx markdownlint-cli2:*)",
      "Bash(mkdir:*)"
    ],
    "deny": [
      "mcp__github__delete_file",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 60,
            "statusMessage": "origin/main と並行作業の状態を確認中..."
          }
        ]
      }
    ]
  }
}
